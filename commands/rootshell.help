#!/usr/bin/env bash
[[ ! ${ROLL_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1
## @description: Open a root shell in the project container using its configured shell.
## @category: utility

ROLL_USAGE=$(cat <<EOF
\033[33mUsage:\033[0m
  rootshell [args]
\033[33mOptions:\033[0m
  -h, --help        Display this help menu
EOF
)
