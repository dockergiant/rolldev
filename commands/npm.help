#!/usr/bin/env bash
[[ ! ${ROLL_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1
## @description: Run npm inside the project php-fpm container.
## @category: utility

NPM_HELP=$("${ROLL_DIR}/bin/roll" cli "npm --help")

ROLL_USAGE=$(cat <<EOF
${NPM_HELP}
EOF
)
