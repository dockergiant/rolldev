#!/usr/bin/env bash
[[ ! ${ROLL_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1
## @description: Run n98-magerun2 inside the project php-fpm container.
## @category: magento2

ROLL_USAGE=$(cat <<EOF
\033[33mUsage:\033[0m
  magerun [args]
\033[33mOptions:\033[0m
  -h, --help        Display this help menu
EOF
)
