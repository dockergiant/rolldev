#!/usr/bin/env bash
[[ ! ${ROLL_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1
## @description: Launch TablePlus connected to the project database.
## @category: database

ROLL_USAGE=$(cat <<EOF
\033[33mUsage:\033[0m
  tableplus         Open the current project database in TablePlus (macOS only)
\033[33mOptions:\033[0m
  -h, --help        Display this help menu
EOF
)
