#!/usr/bin/env bash
[[ ! ${ROLL_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1
## @description: Set up automatic admin login for the project Magento 1 install.
## @category: magento1

ROLL_USAGE=$(cat <<EOH
\033[33mUsage:\033[0m
  setup-autologin    create the admin user localadmin with password admin123

\033[33mDescription:\033[0m
  With ROLL_ADMIN_AUTOLOGIN=1 in .env.roll, nginx adds a script to the admin
  login page that signs in as localadmin. Run roll env up after changing it.

\033[33mOptions:\033[0m
  -h, --help        Display this help menu
EOH
)
