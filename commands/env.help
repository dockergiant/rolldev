#!/usr/bin/env bash
[[ ! ${ROLL_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1
## @description: Run docker compose subcommands scoped to the project environment.
## @category: environment

COMPOSE_USAGE=$(docker compose "${ROLL_PARAMS[@]}" "$@" \
  | grep -vE '(--file|--project-name|--project-directory|default: docker-compose.yml|default: directory name)' \
  | sed '1d;2d;s/docker-compose/env/' \
  | sed -E "s/^(Usage|Options|Commands):/$(echo -e "\033[33m\\1:\033[0m")/g"
)

ROLL_USAGE=$(cat <<EOF
${COMPOSE_USAGE}

\033[33mRoll-specific subcommands:\033[0m

  roll env describe
    Show the services, URLs and versions of the current project.

  roll env doctor
    Check whether the project environment is fit to run: Docker, configuration, container
    health, host ports, the search engine and disk headroom. See \033[31m'roll doctor -h'\033[0m.

  roll env up --wait
    Passed through to docker compose: waits until every service with a healthcheck reports
    healthy, so a following command such as a database import does not race a starting service.

  roll env sh <service> '<command>'
    Run a shell command inside a container. Redirects and pipes apply inside the container:
      roll env exec php-fpm echo hi > /tmp/probe  # writes /tmp/probe on the HOST
      roll env sh php-fpm 'echo hi > /tmp/probe'  # writes /tmp/probe in the CONTAINER

    \033[1mExamples:\033[0m
      roll env sh php-fpm 'cat app/etc/env.php | grep MODE'
      roll env sh php-fpm 'ls -la | grep vendor'
EOF
)
