
# The local type gets no php-fpm, and the nginx and db fragments depend on it, so services stay off
# until .roll/roll-env.yml defines what the project runs
ROLL_NGINX=0
ROLL_DB=0
ROLL_REDIS=0

NGINX_VERSION=1.30
DB_DISTRIBUTION=mariadb
DB_DISTRIBUTION_VERSION=10.4
REDIS_DISTRIBUTION=redis
REDIS_VERSION=7.0
