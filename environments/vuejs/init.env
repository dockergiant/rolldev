
ROLL_DB=1
ROLL_REDIS=1

DB_DISTRIBUTION=mariadb
DB_DISTRIBUTION_VERSION=10.4
NGINX_VERSION=1.30
NODE_VERSION=18
COMPOSER_VERSION=2
PHP_VERSION=8.1
PHP_XDEBUG_3=1
